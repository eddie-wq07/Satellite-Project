{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "python": "${config:python.defaultInterpreterPath}",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Factory: demo",
            "type": "debugpy",
            "request": "launch",
            "python": "${config:python.defaultInterpreterPath}",
            "program": "${workspaceFolder}/scripts/run_factory.py",
            "args": [
                "--mode",
                "demo"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Factory: drive",
            "type": "debugpy",
            "request": "launch",
            "python": "${config:python.defaultInterpreterPath}",
            "program": "${workspaceFolder}/scripts/run_factory.py",
            "args": [
                "--mode",
                "drive"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Factory: train",
            "type": "debugpy",
            "request": "launch",
            "python": "${config:python.defaultInterpreterPath}",
            "program": "${workspaceFolder}/scripts/run_factory.py",
            "args": [
                "--mode",
                "train",
                "--num-envs",
                "8",
                "--iterations",
                "500"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Factory: play",
            "type": "debugpy",
            "request": "launch",
            "python": "${config:python.defaultInterpreterPath}",
            "program": "${workspaceFolder}/scripts/run_factory.py",
            "args": [
                "--mode",
                "play",
                "--num-envs",
                "8",
                "--checkpoint",
                "${input:checkpoint}"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ],
    "inputs": [
        {
            "id": "checkpoint",
            "type": "promptString",
            "description": "Path to a trained PPO checkpoint",
            "default": "outputs/training/model_499.pt"
        }
    ]
}
